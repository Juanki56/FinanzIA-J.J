SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Solo la usa el cron de sincronización de correos (src/cron/sincronizacionCron.ts).
# Nunca debe llegar al frontend ni a ningún cliente. Sin esta variable, el cron
# simplemente no arranca (el resto del backend funciona igual).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=3001

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/conexiones/google/callback
FRONTEND_URL=http://localhost:5173

# Cada cuántos minutos corre el cron de sincronización de correos.
SYNC_INTERVAL_MINUTOS=30

# Gratis en Google AI Studio (aistudio.google.com), sin tarjeta de crédito.
# En el nivel gratuito, Google puede usar el contenido enviado para mejorar
# sus modelos -- por eso solo se le manda un payload minimizado, nunca datos
# que identifiquen al usuario ni el correo crudo (ver services/categorizacionIA.service.ts).
GEMINI_API_KEY=your-gemini-api-key
# Verificado como vigente y gratuito en https://ai.google.dev/gemini-api/docs/pricing
# al momento de construir esto. Google renombra/retira modelos cada pocos
# meses -- si este deja de existir, revisa esa página para el reemplazo vigente.
GEMINI_MODEL=gemini-3.5-flash-lite
