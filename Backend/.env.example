SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Solo la usa el cron de sincronización de correos (src/cron/sincronizacionCron.ts).
# Nunca debe llegar al frontend ni a ningún cliente. Sin esta variable, el cron
# simplemente no arranca (el resto del backend funciona igual).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=3001

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Apunta al FRONTEND, no al backend -- Google redirige aquí directamente
# después del consentimiento, y el frontend es quien llama al backend con el
# código (POST /api/conexiones/google/callback, autenticado). Esto evita
# depender de estado guardado en memoria del servidor entre dos peticiones,
# que se rompería en un entorno con múltiples instancias (ej. Vercel).
# Debe coincidir EXACTAMENTE con una "Authorized redirect URI" configurada en
# Google Cloud Console para este client_id.
GOOGLE_REDIRECT_URI=http://localhost:5173/conexiones

# Cada cuántos minutos corre el cron LOCAL de sincronización de correos
# (node-cron, dentro del proceso -- solo funciona si el backend vive en un
# proceso siempre encendido: tu máquina, Render, Railway, etc).
SYNC_INTERVAL_MINUTOS=30

# Protege GET /api/cron/sincronizar (pensado para Vercel Cron Jobs u otro
# scheduler externo, no para node-cron). Genera un string aleatorio de al
# menos 16 caracteres. Sin esta variable, ese endpoint responde 503 siempre.
CRON_SECRET=un-string-aleatorio-largo

# Gratis en Google AI Studio (aistudio.google.com), sin tarjeta de crédito.
# En el nivel gratuito, Google puede usar el contenido enviado para mejorar
# sus modelos -- por eso solo se le manda un payload minimizado, nunca datos
# que identifiquen al usuario ni el correo crudo (ver services/categorizacionIA.service.ts).
GEMINI_API_KEY=your-gemini-api-key
# Verificado como vigente y gratuito en https://ai.google.dev/gemini-api/docs/pricing
# al momento de construir esto. Google renombra/retira modelos cada pocos
# meses -- si este deja de existir, revisa esa página para el reemplazo vigente.
GEMINI_MODEL=gemini-3.5-flash-lite
